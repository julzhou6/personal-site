---
// component imports
import MainLayout from "../../../layouts/MainLayout.astro";
import type { ComponentProps } from "astro/types";
import { Image } from "astro:assets";
import cozyCoffee from "../../../images/code-fun/cozy-coffee.gif";
import oak1 from "../../../images/code-fun/oakleaf1.png";
import oak2 from "../../../images/code-fun/oakleaf2.png";
import oak3 from "../../../images/code-fun/oakleaf3.png";

---

<MainLayout title="Reveal | Day 1"> 
    <slot name="head">
        <link rel="octo:octothorpes" href="Reveal" />
    </slot>
    </slot>
  <section class="post">
    <h1 class="page-title heading">REVEAL</h1>
    <button id="reset" onclick="location.reload();">RESET</button>
    <p class="page-title">Drag the oak leaves!</p>
    <div id="page-container" class="page-container">
      <Image id="coffee" src={cozyCoffee} alt="Cozy Coffee" />
        <div class="wrapper">
            <Image class="oak oak--1" src={oak1} alt="Oak Leaf 1" />
        </div>
        <div class="wrapper">
            <Image class="oak oak--2" src={oak2} alt="Oak Leaf 2" />
        </div>
        <div class="wrapper">
            <Image class="oak oak--3" src={oak3} alt="Oak Leaf 3" />
        </div> 
    </div>
  </section>
</MainLayout>
<style>
  img {
    max-width: 400px;
    max-height: 400px;
    width: auto;
    height: auto;
  }

  #reset {
    position: relative;
    z-index: 11;
    margin-top: 20px;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    color: white;
    background-color: var(--nav-light);
  }

  .oak {
    position: absolute;
    cursor: pointer;
    height: auto;
    max-width: 500px;
    top: 50%;
    left: 50%;
    margin-top: -30px;
    margin-left: -220px;
  }

  .oak--1 {
    position: absolute;
    z-index: 10;
    /* left: 400px; */
  }

  .oak--2 {
    position: absolute;
    z-index: 10;
    rotate: 90deg;
    /* left: 600px; */
  }
  
  .oak--3 {
    position: absolute;
    z-index: 10;
    rotate: 45deg;
    /* left: 500px; */
    /* bottom: -20px; */
    }

  #coffee {
    position: relative;
    max-width: 700px;
    height: auto;
    z-index: 9;
    /* padding: 10px; */
  }
  
  #carouselTargetList {
    display: flex;
    flex-wrap: wrap;
    grid-gap: 1rem;
    justify-content: center;
    padding-bottom: 2rem;
  }

  .page-title {
    text-align: center;
  }
  li {
    display: inline-block;
    list-style-type: none;
  }
  .page-container {
    display: flex;
    grid-gap: 1rem;
    justify-content: center;
    padding-bottom: 2rem;
    flex-wrap: wrap;
    max-height: 100vh;
    max-width: 100vw;
  }
  .page-grid {
    visibility: hidden;
    padding-bottom: 2rem;
    width: 300px;
  }

  .post {
    margin: 3rem;
  }
  @media screen and (max-width: 340px) {
    img {
      max-width: 100px;
      max-height: 100px;
    }
    .oak {
        margin-top: -150px;
        margin-left: -150px;
    }
  }
  @media screen and (max-width: 640px) {
    img {
      max-width: 300px;
      max-height: 300px;
    }
    .page-container {
      flex-wrap: wrap;
    }
    .heading {
      font-size: 40px;
    }
    .oak {
        margin-top: -80px;
        margin-left: -90px;
    }
  }
</style>
<script>
  import { gsap } from "gsap";
  import { Draggable } from "gsap/Draggable";
  import { InertiaPlugin } from "gsap/InertiaPlugin";
  gsap.registerPlugin(Draggable, InertiaPlugin);

    Draggable.create(".oak--1", {
        bounds: 'body',
        inertia: true,
    });
    Draggable.create(".oak--2", {
        bounds: 'body',
        inertia: true,
    });
    Draggable.create(".oak--3", {
        bounds: 'body',
        inertia: true,
    });

//   var t1 = gsap.timeline();
//   t1.from(".page-grid", { opacity: 0, duration: 1, autoAlpha: 0 });

</script>
