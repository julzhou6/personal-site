---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from 'astro:assets';
import Icon from "astro-icon";

import meDrawing from "../icons/meDrawing.jpg";
---

<MainLayout title="About">
	<section class="container welcome-text">
        <div>
            <div class="bio-box"> 
                <div id="bio" class="bio">
                    <Image id="me-drawing" class="me-drawing" src={meDrawing} alt="a drawing of me wearing a cat ear tangerine hat" width={200}/>
                    <div id="bio-text">
                        <h1 class="title heading">Hi I'm Julie!</h1>
                        <p>Welcome welcome! I'm an artist and technologist based in Washington, DC! I studied Computer Science and Media Studies at the University of Virginia and worked as a Frontend Engineer -- with a brief stint as a UX/UI Designer -- in the nonprofit and federal sector for a few years. After my second layoff in 2025, I decided to start exploring some of my other creative interests such as comics and illustration. <b>I hope to explore more of the intersection between technology, art, and storytelling.</b></p>
							<p>
								Common subjects of my art include food, nature, and fashion. I'm a budding storyteller interested in writing hopeful stories about inner struggles and growing pains. I also draw a lot of influence from my Chinese-American upbringing.
							</p>
							<p>
								For more musings and thoughts on art and taking the creative path,<b> check out <a href="https://julieqiuli.substack.com/" target="_blank">my blog</a></b>!
                            </p> 
							<p>
                            Currently, I am open to creative collaborations and freelance projects! Feel free to email me at <b>julielinzhou@gmail.com</b>.
                            </p> 
                        <div class="socials">
                            <a href="mailto:julielinzhou@gmail.com" class="social-icon"><Icon name="mail" width="50"/></a>
                            <a href="https://linkedin.com/in/julielinzhou" class="social-icon" target="_blank"> <Icon name="linkedin" width="50"/></a>
                            <a href="https://instagram.com/julieqiuli" class="social-icon" target="_blank"> <Icon name="insta" width="50"/></a>
                            <a href="https://github.com/julzhou6" class="social-icon" target="_blank"><Icon name="github" width="50"/></a>
                        </div>   
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
<style>
	  /* About Bio */
    .welcome-text {
        display: flex;
        justify-content: center;
        padding: 2rem;
        text-align: center;
    }
    img {
        aspect-ratio: auto;
    }
    .me-drawing {
        border-radius: 50%;
    }
    .bio-box {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .cat-box {
        display: flex; 
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        padding-bottom: 1rem;
    }
    @media screen and (min-width: 640px) {
        .bio {
            margin: 0 3rem;
            display: grid;
            grid-template-columns: 1fr 2fr;
            justify-items: center;
            align-items: center;
        }
        
    }
    @media screen and (max-width: 640px) {
        .heading {
            font-size: 50px;
        }
    }
    .social-icon {
        padding-right: 1rem;
    }
    .social-icon:hover {
        shadow: 0px 0px 10px 0px var(--nav-light);
        filter: drop-shadow(0px 0px 3px var(--nav-light));
        transition: 0.2s ease-in-out;
    }
    .cat-mascot {
        visibility: hidden;
    }
    .bio {
        visibility: hidden;
    }
</style>
<script>
    import { gsap } from "gsap";
    var t1 = gsap.timeline();
    t1.from("#bio", {opacity: 0, autoAlpha: 0})
</script>
