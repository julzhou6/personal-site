---
import MainLayout from "../../layouts/MainLayout.astro";
import PreviewPage from "../../layouts/PreviewPage.astro";
import NewPreview from "../../layouts/NewPreview.astro";
import { Image } from 'astro:assets';
import img1 from "../../images/Autumn_Activities.jpg";
import img2 from "../../images/Jasmine_Tea_Girl.png";
import img3 from "../../images/change-texture.png";
import img4 from "../../images/persimmon.png";
import img5 from "../../images/Food_Challenge_Print 2.jpg";
import img6 from "../../images/Food_Challenge_Print 3.jpg";
import img7 from "../../images/streettoast.jpg";
import img8 from "../../images/jade-rabbit-texture.png";
import img9 from "../../images/Mid-autumn-banner.jpg";
import img10 from "../../images/TangyuanBunnies.png";
import img12 from "../../images/Year_Of_Wood_Dragon_.png";
import img13 from "../../images/Year_Of_The_Horse_print.png";
import img14 from "../../images/Fall.jpg";
import img15 from "../../images/cozy-coffee.jpg";
import img16 from "../../images/Page4.jpeg";
import img17 from "../../images/shrimp-sticker-promo.jpg";
import img18 from "../../images/duck-promo.jpg";
import img19 from "../../images/dc-travel-print.png";
import img20 from "../../images/Flora_Sticker_Sheet.png";

const images = [
  { src: img1, alt: "Autumn Activities" },
  { src: img2, alt: "Jasmine Tea Girl" },
  { src: img4, alt: "Persimmon" },
  { src: img10, alt: "Tangyuan Bunnies" },
  { src: img5, alt: "ramen" },
  { src: img6, alt: "japanese cheesecake" },
  { src: img7, alt: "korean street toast" },
  { src: img3, alt: "Change Texture" },
  { src: img8, alt: "Jade Rabbit Texture" },
  { src: img9, alt: "Mid Autumn Banner" },
  { src: img12, alt: "Year Of Wood Dragon" },
  { src: img13, alt: "Year Of The Horse" }, 
  { src: img14, alt: "Fall Characters" }, 
    { src: img15, alt: "Cozy Coffee" },
    { src: img16, alt: "duck in a river" }, 
    { src: img17, alt: "shrimp sticker" },
    { src: img18, alt: "duck sticker" },
    { src: img19, alt: "DC Travel Print" },
    { src: img20, alt: "Flora Sticker Sheet" }
];

const everythinggoes = {
    url: img16,
    alt: "Illustration of a Duck in a River",
    slug: "/illustration/it-shall-pass",
    title: "It Shall Pass",
};
---
<MainLayout title="Illustration">
    <section class="post">
    <h1>ILLUSTRATION</h1>
    <h2>Collections</h2>
    <div class="page-container">
      <div class="image-grid">
       <!-- <PreviewPage page={everythinggoes} wp={false} /> -->
        <NewPreview page={everythinggoes} />
        </div>
    </div>
    <h2>Character</h2>
    <div class="page-container">
      <ul id="image-list">
          <li class="image-grid">
            <Image src={img2} alt="Jasmine Tea Girl" />
          </li>
          <li class="image-grid">
            <Image src={img3} alt="Change Texture" />
          </li>
           <li class="image-grid">
            <Image src={img8} alt="Jade Rabbit Texture" />
          </li>
          <li class="image-grid">
            <Image src={img12} alt="Year of the Wood Dragon" />
          </li>
          <li class="image-grid">
            <Image src={img14} alt="Fall Characters" />
          </li>
          <li class="image-grid">
            <Image src={img15} alt="Cozy Coffee" />
          </li>
        </ul>
    </div>
    <h2>Food</h2>
    <div class="page-container">
        <ul id="image-list">
            <li class="image-grid">
                <Image src={img6} alt="japanese cheesecake" />
            </li>
            <li class="image-grid">
                <Image src={img5} alt="ramen" />
            </li>
             <li class="image-grid">
                <Image src={img10} alt="Tangyuan Bunnies" />
            </li>
            <li class="image-grid">
                <Image src={img4} alt="persimmon" />
            </li>
            <li class="image-grid">
                <Image src={img7} alt="korean street toast" />
            </li>
            <li class="image-grid">
                <Image src={img9} alt="Mid Autumn Banner" />
            </li>
        </ul>
    </div>
    <h2>Print / Sticker</h2>
    <div class="page-container">
      <ul id="image-list">
        <li class="image-grid">
            <Image src={img17} alt="shrimp sticker" />
        </li>
            <li class="image-grid">
            <Image src={img18} alt="duck sticker" />
            </li>
            <li class="image-grid">
                <Image src={img19} alt="DC Travel Print" />
            </li>
            <li class="image-grid">
                <Image src={img20} alt="Flora Sticker Sheet" />
            </li>
            <li class="image-grid">
                <Image src={img13} alt="Year of the Horse" />
            </li>
        </ul>
    </div>
    <!-- <div class="page-container">
      <ul id="image-list">
        {images.map((image) => (
          <li class="image-grid">
            <Image src={image.src} alt={image.alt} />
          </li>
        ))}
        </ul>
    </div> -->
  </section>
</MainLayout>
<style>
    .post {
        max-width: 90%;
    }
    img {
        max-width: 350px;
        max-height: 350px;
        width: auto;
        height: auto;
    }
    .section-text {
        text-align: center;
        width: 100%;
    }

    #image-list {
        display: flex;
        flex-wrap: wrap;
        grid-gap: 1rem;
        justify-content: left;
        padding: 0;
    }

    .bb-cover {
        border: 1px solid;
        border-color: orange;
        border-radius: 10px;
    }
    .bb-cover:hover {
        opacity: 70%;
        transition: 0.2s ease-in-out;
    }
    .page-title {
        text-align: center;
    }
    li {
        display: inline-block;
        list-style-type: none;
    }
    .page-container {
        display: flex;
        /* grid-gap: 1rem; */
        justify-content: left;
        padding-bottom: 2rem;
        flex-wrap: wrap;
    }
    .insta-block {
        display: flex;
        flex-direction: row;
        align-items: center;
        grid-gap: 2rem; 
    }
    .image-grid {
        visibility: hidden;
        justify-self: center;
        align-self: center;
        /* padding-bottom: 2rem;
        width: 300px; */
    }
    @media screen and (max-width: 340px) {
        img {
        max-width: 200px;
        max-height: 200px;
        }
    }
    @media screen and (max-width: 640px) {
        .page-container {
        flex-wrap: wrap;
        }
        .heading {
        font-size: 40px;
        }
    }
</style>
<script>
    import { gsap } from "gsap";
  var t1 = gsap.timeline();
  t1.from(".image-grid", { opacity: 0, duration: 1, autoAlpha: 0 });
</script>