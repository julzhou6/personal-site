---
import MainLayout from "../layouts/MainLayout.astro";
import meDrawing from "../icons/medrawing.png";
import { Image } from 'astro:assets';
import Icon from "astro-icon";
import { gsap } from "gsap";
import Projects from "../components/Projects.astro";
import Illustration from "../components/Illustration.astro";
---

<MainLayout title="Home | Julie Zhou">
    <section class="container welcome-text">
        <div>
            <div class="bio-box"> 
                <div id="bio" class="bio">
                    <Image id="me-drawing" class="me-drawing" src={meDrawing} alt="a drawing of me wearing a cat ear tangerine hat" width={200}/>
                    <div id="bio-text">
                        <h1 class="title heading">Hi I'm Julie!</h1>
                        <p>Welcome welcome! I'm an artist and technologist based in Washington DC! I love to explore the relationship between food, nature, and identity through different mediums like digital art, color pencil, sculpting and more.</p>
                            <p>
                            Currently, I am open to creative collaborations and freelance projects!
                            </p> 
                        <div class="socials">
                            <a href="mailto:julielinzhou@gmail.com" class="social-icon"><Icon name="mail" width="50"/></a>
                            <a href="https://linkedin.com/in/julielinzhou" class="social-icon" target="_blank"> <Icon name="linkedin" width="50"/></a>
                            <a href="https://instagram.com/julieqiuli" class="social-icon" target="_blank"> <Icon name="insta" width="50"/></a>
                            <a href="https://github.com/julzhou6" class="social-icon" target="_blank"><Icon name="github" width="50"/></a>
                        </div>   
                    </div>
                </div>
            </div>
        </div>
    </section>
    <Projects />
    <Illustration />
</MainLayout>
<style>
    /* About Bio */
    .welcome-text {
        display: flex;
        justify-content: center;
        padding: 2rem;
        text-align: center;
    }
    img {
        aspect-ratio: auto;
    }
    .me-drawing {
        border-radius: 50%;
    }
    .bio-box {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .cat-box {
        display: flex; 
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        padding-bottom: 1rem;
    }
    @media screen and (min-width: 640px) {
        .bio {
            margin: 0 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            justify-items: center;
            align-items: center;
        }
        
    }
    @media screen and (max-width: 640px) {
        .heading {
            font-size: 50px;
        }
    }
    .social-icon {
        padding-right: 1rem;
    }
    .social-icon:hover {
        shadow: 0px 0px 10px 0px var(--nav-light);
        filter: drop-shadow(0px 0px 3px var(--nav-light));
        transition: 0.2s ease-in-out;
    }
    .cat-mascot {
        visibility: hidden;
    }
    .bio {
        visibility: hidden;
    }
</style>
<script>
    import { gsap } from "gsap";
    var t1 = gsap.timeline();
    t1.from("#bio", {opacity: 0, autoAlpha: 0})
</script>
